      "italic": true
    },
    "variable": "#ECE8FA",
    "variable.readonly": "#FFB38A",
    "variable.constant": "#FFB38A",
    "variable.defaultLibrary": "#FFD480",
    "keyword": "#AA94FF",
    "label": "#6FE0D2",
    "regexp": "#6FE0D2",
    "operator": "#D3CCF0",
    "comment": {
