  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#A39ACD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation entity.name.tag",
        "storage.type.class.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#AA94FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other.using",
        "keyword.other.import",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#AA94FF"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.return",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#AA94FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#D3CCF0"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#AA94FF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A6E3A1"
      }
    },
    {
      "name": "Escapes, regex, interpolation",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#6FE0D2"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#FFB38A"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7CC4FF"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.class",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#FFD480"
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.namespace",
        "entity.name.package",
        "storage.modifier.import.java"
      ],
      "settings": {
        "foreground": "#C9C2E8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#ECE8FA"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#F0C6A0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.variable.field",
        "variable.other.member",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F5A8D0"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF8FA3"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#FFD480",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS",
      "scope": [
        "support.type.property-name.css",
        "support.type.vendored.property-name.css"
      ],
      "settings": {
        "foreground": "#F5A8D0"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#FFB38A"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key.python"
      ],
      "settings": {
        "foreground": "#F5A8D0"
      }
    },
    {
      "name": "SQL",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.create",
        "keyword.other.data-integrity"
      ],
      "settings": {
        "foreground": "#AA94FF"
      }
    },
    {
      "name": "SQL functions",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
        "support.function.string.sql"
      ],
      "settings": {
        "foreground": "#7CC4FF"
      }
    },
    {
      "name": "PowerShell variables",
      "scope": [
        "variable.other.readwrite.powershell",
        "punctuation.definition.variable.powershell",
        "support.variable.automatic.powershell"
      ],
      "settings": {
        "foreground": "#F5A8D0"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#6FE0D2"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF7A8A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFCB6B",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#AA94FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
