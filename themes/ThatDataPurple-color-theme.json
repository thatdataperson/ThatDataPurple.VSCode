      "foreground": "#FFD480",
      "italic": true
    },
    "type": "#FFD480",
    "enumMember": "#FFB38A",
    "function": "#7CC4FF",
    "method": "#7CC4FF",
    "macro": "#6FE0D2",
    "decorator": "#7CC4FF",
    "property": "#F5A8D0",
    "event": "#F5A8D0",
    "parameter": {
